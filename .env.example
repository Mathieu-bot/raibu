# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/raibu
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER_URI=https://accounts.google.com

# Server
PORT=8080

# Frontend (OAuth2 login/logout redirects)
FRONTEND_URL=http://localhost:5173

# CORS + WebSocket allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://raibu.app

# OpenAPI documentation links
API_LOCAL_URL=http://localhost:8080
API_PRODUCTION_URL=https://api.raibu.app
CONTACT_URL=https://raibu.app
